# discord slash commands (POST <forlorn>/discord/interactions).
# empty = endpoint returns 503. setup: discord portal -> your app ->
# General Information (copy Application Public Key) -> Installation, then
# register once, e.g.:
#   curl -X POST -H "Authorization: Bot $BOT_TOKEN" -H "Content-Type: application/json" \
#     -d '{"name":"rank","description":"change map ranked status",
#           "options":[{"name":"status","type":3,"required":true,"choices":[
#             {"name":"rank","value":"rank"},{"name":"unrank","value":"unrank"},
#             {"name":"love","value":"love"},{"name":"qual","value":"qual"}]},
#            {"name":"scope","type":3,"required":false,"choices":[
#             {"name":"map","value":"map"},{"name":"set","value":"set"}]},
#            {"name":"target","type":4,"required":true}]}' \
#     https://discord.com/api/v10/applications/$APP_ID/commands
# then set the app's Interactions Endpoint URL to <forlorn>/discord/interactions.
DISCORD_PUBLIC_KEY=
DISCORD_STAFF_ROLE_IDS=

OSU_API_KEY=